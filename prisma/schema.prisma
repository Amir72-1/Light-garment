generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  OWNER
  MANAGER
  STOREKEEPER
  SALESPERSON
  HR_ADMIN
}

enum Department {
  PRODUCTION
  SALES
  ADMIN
  STORE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum YearlyBreakStatus {
  SCHEDULED
  TAKEN
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  SALE
  ADJUSTMENT
}

enum BundleStatus {
  ACTIVE
  DEPLETED
  SPLIT
  ARCHIVED
}

enum StockTransactionType {
  RECEIVING
  TRANSFER
  SALE
  RETURN
  PRODUCTION_CONSUMPTION
  ADJUSTMENT
  CYCLE_COUNT
  SPLIT
}

enum ProductionWorkflowStage {
  FABRIC
  CUTTING
  SEWING
  PRINTING
  IRONING
  PACKAGING
  FINISHED_GOODS
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
}

enum RawMaterialCategory {
  FABRIC
  THREAD
  BUTTONS
  LABELS
  PACKAGING
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  roleId             String
  role               Role                 @relation(fields: [roleId], references: [id])
  employeeId         String?              @unique
  employee           Employee?            @relation(fields: [employeeId], references: [id])
  passwordResetTokens PasswordResetToken[]
  sales              Sale[]
  salaryHistoryChanges SalaryHistory[]
  yearlyBreakRegistrations YearlyBreak[]
  stockTransactions StockTransaction[]
  qrCodeHistory QrCodeHistory[]
  inventoryAuditLogs InventoryAuditLog[]
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Employee {
  id             String          @id @default(cuid())
  employeeCode   String          @unique
  fullName       String
  profileImageUrl String?         @db.Text
  idImageUrl      String?         @db.Text
  idImageBackUrl  String?         @db.Text
  faydaNumber    String?         @unique
  bankAccountNumber String?
  phoneNumber    String
  email          String?         @unique
  address        String
  gender         Gender
  dateOfBirth    DateTime
  position       String
  department     Department
  salary         Decimal         @db.Decimal(12, 2)
  employmentType EmploymentType
  hireDate       DateTime
  status         EmployeeStatus  @default(ACTIVE)
  archivedAt     DateTime?
  user           User?
  attendance     Attendance[]
  payrolls       Payroll[]
  salaryHistory  SalaryHistory[]
  yearlyBreaks   YearlyBreak[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        String
  checkInTime String?
  checkOutTime String?
  status      AttendanceStatus @default(ABSENT)
  totalHours  Float?
  overtimeHours Float?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model Supplier {
  id           String        @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  products     Product[]
  rawMaterials RawMaterial[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Product {
  id               String              @id @default(cuid())
  sku              String              @unique
  productName      String
  model            String
  color            String
  size             String
  quantity         Int                 @default(0)
  costPrice        Decimal             @db.Decimal(12, 2)
  sellingPrice     Decimal             @db.Decimal(12, 2)
  images           String[]
  barcode          String?             @unique
  qrCode           String?
  supplierId       String?
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryMoves   Inventory[]
  saleItems        SaleItem[]
  productionStages ProductionStage[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Inventory {
  id              String                @id @default(cuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            InventoryMovementType
  quantity        Int
  fromLocation    String?
  toLocation      String?
  reference       String?
  note            String?
  createdAt       DateTime              @default(now())
}

model RawMaterial {
  id             String              @id @default(cuid())
  name           String
  category       RawMaterialCategory
  unit           String
  quantity       Decimal             @db.Decimal(12, 2)
  reorderLevel   Decimal             @db.Decimal(12, 2)
  unitCost        Decimal             @db.Decimal(12, 2)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  movements      RawMaterialMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model RawMaterialMovement {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  type          String
  quantity      Decimal     @db.Decimal(12, 2)
  unit          String
  reference     String?
  note          String?
  createdAt     DateTime    @default(now())
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  customerName  String?
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus
  paymentMethod PaymentMethod
  items         SaleItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
}

model ProductionStage {
  id          String                  @id @default(cuid())
  productId   String
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  stage       ProductionWorkflowStage
  status      ProductionStatus        @default(PENDING)
  assignedTo  String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([productId, stage])
}

model Payroll {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollMonth  Int
  payrollYear   Int
  basicSalary   Decimal       @db.Decimal(12, 2)
  overtimeHours Decimal       @db.Decimal(10, 2) @default(0)
  overtimePay   Decimal       @db.Decimal(12, 2) @default(0)
  bonus         Decimal       @db.Decimal(12, 2) @default(0)
  allowance     Decimal       @db.Decimal(12, 2) @default(0)
  deductions    Decimal       @db.Decimal(12, 2) @default(0)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  absentDays    Int           @default(0)
  lateDays      Int           @default(0)
  workingDays   Int
  payableSalary Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  paymentDate   DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  auditLogs     PayrollAuditLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([employeeId, payrollMonth, payrollYear])
  @@index([payrollYear, payrollMonth])
}

model PayrollAuditLog {
  id        String   @id @default(cuid())
  payrollId String
  payroll   Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model SalaryHistory {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousSalary  Decimal  @db.Decimal(12, 2)
  newSalary       Decimal  @db.Decimal(12, 2)
  effectiveDate   DateTime
  reason          String?
  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model YearlyBreak {
  id                 String            @id @default(cuid())
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year               Int
  startDate          DateTime
  endDate            DateTime
  days               Int
  status             YearlyBreakStatus @default(SCHEDULED)
  notes              String?
  registeredByUserId String?
  registeredBy       User?             @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([employeeId, year])
  @@index([year])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FabricType {
  id        String           @id @default(cuid())
  name      String           @unique
  products  ProductCatalog[]
  createdAt DateTime         @default(now())
}

model ColorOption {
  id        String           @id @default(cuid())
  name      String           @unique
  code      String?          @unique
  hexCode   String?
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
}

model SizeOption {
  id        String           @id @default(cuid())
  code      String           @unique
  sortOrder Int              @default(0)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
}

model ProductCatalog {
  id         String            @id @default(cuid())
  name       String
  style      String
  fabricId   String?
  fabric     FabricType?       @relation(fields: [fabricId], references: [id], onDelete: SetNull)
  skuPrefix  String?
  variants   ProductVariant[]
  bundles    InventoryBundle[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([name])
}

model ProductVariant {
  id               String          @id @default(cuid())
  productCatalogId String
  productCatalog   ProductCatalog  @relation(fields: [productCatalogId], references: [id], onDelete: Cascade)
  colorId          String
  color            ColorOption     @relation(fields: [colorId], references: [id])
  sizeId           String
  size             SizeOption      @relation(fields: [sizeId], references: [id])
  sku              String          @unique
  costPrice        Decimal         @db.Decimal(12, 2)
  sellingPrice     Decimal         @db.Decimal(12, 2)
  images           String[]
  bundles          InventoryBundle[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([productCatalogId, colorId, sizeId])
}

model Warehouse {
  id          String             @id @default(cuid())
  name        String             @unique
  code        String             @unique
  address     String?
  locations   StorageLocation[]
  bundles     InventoryBundle[]
  stockFrom   StockTransaction[] @relation("FromWarehouse")
  stockTo     StockTransaction[] @relation("ToWarehouse")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model StorageLocation {
  id          String            @id @default(cuid())
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String
  bundles     InventoryBundle[]
  createdAt   DateTime          @default(now())

  @@unique([warehouseId, code])
}

model InventoryBundle {
  id                String            @id @default(cuid())
  bundleNumber      String            @unique
  qrCodeNumber      String            @unique
  qrPayload         String            @unique
  qrImageUrl        String?           @db.Text
  productCatalogId  String
  productCatalog    ProductCatalog    @relation(fields: [productCatalogId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName       String
  style             String
  fabric            String?
  color             String
  colorCode         String?
  size              String
  piecesPerBundle   Int
  remainingPieces   Int
  unitCost          Decimal           @db.Decimal(12, 2)
  sellingPrice      Decimal           @db.Decimal(12, 2)
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
  storageLocationId String?
  storageLocation   StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  status            BundleStatus      @default(ACTIVE)
  parentBundleId    String?
  parentBundle      InventoryBundle?  @relation("BundleSplit", fields: [parentBundleId], references: [id], onDelete: SetNull)
  childBundles      InventoryBundle[] @relation("BundleSplit")
  legacyProductId   String?
  version           Int               @default(1)
  transactions      StockTransaction[]
  qrHistory         QrCodeHistory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([productCatalogId])
  @@index([warehouseId])
  @@index([qrCodeNumber])
  @@index([bundleNumber])
  @@index([productName])
  @@index([color])
  @@index([size])
}

model StockTransaction {
  id                  String               @id @default(cuid())
  bundleId            String
  bundle              InventoryBundle      @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  type                StockTransactionType
  quantity            Int
  fromWarehouseId     String?
  fromWarehouse       Warehouse?           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId       String?
  toWarehouse         Warehouse?           @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  fromLocationId      String?
  toLocationId        String?
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  reason              String?
  referenceNumber     String               @unique
  sourceBundleId      String?
  destinationBundleId String?
  note                String?
  ipAddress           String?
  createdAt           DateTime             @default(now())

  @@index([bundleId])
  @@index([createdAt])
}

model QrCodeHistory {
  id           String          @id @default(cuid())
  bundleId     String
  bundle       InventoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  qrCodeNumber String
  action       String
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([bundleId])
  @@index([qrCodeNumber])
}

model InventoryAuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
